{
  "name": "profiler-md",
  "version": "0.4.0",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "description": "Converts performance profiles to human and LLM friendly Markdown.",
  "keywords": [
    "ai",
    "bun",
    "chrome",
    "cli",
    "cpu",
    "deno",
    "deopt",
    "deoptimization",
    "devtools",
    "heap",
    "llm",
    "markdown",
    "md",
    "node",
    "optimization",
    "perf",
    "performance",
    "pretty",
    "profile",
    "profiler",
    "snapshot",
    "speedscope",
    "timing",
    "v8"
  ],
  "homepage": "https://github.com/TomerAberbach/profiler-md",
  "repository": "TomerAberbach/profiler-md",
  "bugs": {
    "url": "https://github.com/TomerAberbach/profiler-md/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/TomerAberbach"
  },
  "license": "MIT",
  "files": [
    "examples",
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">= 22"
  },
  "bin": {
    "profiler-md": "./dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base .",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "bench": "./scripts/bench",
    "build": "tsdown",
    "generate-fixtures": "./scripts/generate-fixtures",
    "update-readme": "node scripts/update-readme.ts",
    "check-readme": "node scripts/update-readme.ts --check",
    "update-examples": "node scripts/update-examples.ts",
    "check-examples": "node scripts/update-examples.ts --check",
    "pub": "./scripts/publish",
    "prepublishOnly": "./scripts/check-publish && pnpm build"
  },
  "prettier": "@tomer/prettier-config",
  "dependencies": {
    "@optique/core": "^1.1.0",
    "@optique/run": "^1.1.0",
    "@shikijs/core": "^4.2.0",
    "@shikijs/engine-oniguruma": "^4.2.0",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "ansis": "^4.3.1",
    "convert-source-map": "^2.0.0",
    "globals": "^17.6.0",
    "jumbo-json": "^0.2.0",
    "picomatch": "^4.0.4",
    "plur": "^6.0.0",
    "pprof-format": "^2.2.2",
    "pretty-bytes": "^7.1.0",
    "pretty-ms": "^9.3.0",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@tomer/eslint-config": "^5.1.1",
    "@tomer/prettier-config": "^4.0.1",
    "@types/convert-source-map": "^2.0.3",
    "@types/mdast": "^4.0.4",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "dedent": "^1.7.2",
    "diff": "^9.0.0",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "limit-concur": "^4.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "rollup-plugin-tree-shakeable": "^2.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

{
  "name": "profiler-md",
  "version": "0.9.2",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "description": "Converts performance profiles to human and LLM friendly Markdown.",
  "keywords": [
    "ai",
    "bun",
    "chrome",
    "cli",
    "cpu",
    "deno",
    "deopt",
    "deoptimization",
    "devtools",
    "heap",
    "llm",
    "markdown",
    "md",
    "node",
    "optimization",
    "perf",
    "performance",
    "pretty",
    "profile",
    "profiler",
    "snapshot",
    "speedscope",
    "timing",
    "v8"
  ],
  "homepage": "https://github.com/TomerAberbach/profiler-md",
  "repository": "TomerAberbach/profiler-md",
  "bugs": {
    "url": "https://github.com/TomerAberbach/profiler-md/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/TomerAberbach"
  },
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "!docs/CLAUDE.md",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "bin": {
    "profiler-md": "./dist/cli/index.mjs"
  },
  "man": [
    "./dist/man/profiler-md.1"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "node": "./dist/node/index.mjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#compression": {
      "node": "./src/formats/compression.node.ts",
      "default": "./src/formats/compression.web.ts"
    }
  },
  "scripts": {
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base .",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "bench": "./scripts/bench",
    "categories": "node scripts/categories.ts",
    "evaluate-diff-matching": "node scripts/evaluate-diff-matching/index.ts",
    "update-diff-matching": "node scripts/evaluate-diff-matching/index.ts --update-stale",
    "check-diff-matching": "node scripts/evaluate-diff-matching/index.ts --check",
    "evaluate-call-tree": "node scripts/evaluate-call-tree/index.ts",
    "build": "tsdown && node scripts/build-man.ts",
    "generate-inputs": "./scripts/generate-inputs",
    "update-readme": "node scripts/update-readme.ts",
    "check-readme": "node scripts/update-readme.ts --check",
    "update-demo": "node scripts/update-demo.ts",
    "check-demo": "node scripts/update-demo.ts --check",
    "update-examples": "node scripts/update-examples/index.ts",
    "check-examples": "node scripts/update-examples/index.ts --check",
    "diff-examples": "node scripts/diff-examples/index.ts",
    "check-input-privacy": "node scripts/check-input-privacy.ts",
    "check-bash": "./scripts/check-bash",
    "check": "node scripts/check.ts",
    "check:inputs": "node scripts/check.ts inputs",
    "check:static": "node scripts/check.ts static",
    "prepublishOnly": "pnpm build"
  },
  "prettier": "@tomer/prettier-config",
  "dependencies": {
    "@optique/core": "^1.4.0",
    "@optique/run": "^1.4.0",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-oniguruma": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "ansis": "^4.5.0",
    "convert-source-map": "^2.0.0",
    "globals": "^17.14.0",
    "jumbo-json": "^0.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.1",
    "mdast-util-to-markdown": "^2.2.4",
    "micromark-extension-gfm-table": "^2.1.2",
    "plur": "^7.0.0",
    "pprof-format": "^2.4.1",
    "pretty-bytes": "^7.2.0",
    "pretty-ms": "^10.0.0",
    "source-map-js": "^1.2.4"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.6.0",
    "@optique/man": "^1.4.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@secretlint/core": "^14.1.0",
    "@tomer/eslint-config": "^7.0.0",
    "@tomer/prettier-config": "^5.0.0",
    "@types/convert-source-map": "^2.0.3",
    "@types/mdast": "^4.0.4",
    "@vitest/coverage-v8": "^5.1.2",
    "cookie": "^2.0.2",
    "dedent": "^1.7.2",
    "eslint": "^10.15.0",
    "ip-address": "^10.7.6",
    "knip": "^6.48.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "rollup-plugin-tree-shakeable": "^2.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}

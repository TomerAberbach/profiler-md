{
  "permissions": {
    "allow": [
      "Bash(pnpm format *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm coverage *)",
      "Bash(pnpm bench *)",
      "Bash(pnpm build *)",
      "Bash(pnpm update-readme *)",
      "Bash(pnpm check-readme *)",
      "Bash(pnpm update-demo *)",
      "Bash(pnpm check-demo *)",
      "Bash(pnpm update-examples *)",
      "Bash(pnpm check-examples *)",
      "Bash(node src/cli/index.ts *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-format.sh",
            "statusMessage": "Linting and formatting..."
          }
        ]
      }
    ]
  }
}
